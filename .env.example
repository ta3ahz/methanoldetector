# --- HTTP / TCP portları ---
# Railway TCP Proxy trafiği konteynerin PORT'una yönlendirir; bu yüzden Modbus
# TCP server PORT'u kullanır. HTTP dashboard ise ayrı HTTP_PORT'ta çalışır.
# İkisi FARKLI olmalı.
HTTP_PORT=8080     # dashboard/API
PORT_TCP=5020      # Modbus TCP (lokal). Railway'de PORT bunu ele geçirir.

# --- Modbus ---
MODBUS_SLAVE_ID=1
POLL_INTERVAL_MS=5000
MODBUS_TIMEOUT_MS=2000
COMM_LOSS_THRESHOLD=3

# --- Alarm eşikleri (%LEL) ---
ALARM_LOW_LEL=10
ALARM_HIGH_LEL=20
DATA_STALE_S=60
ALARM_REPEAT_MIN=30

# --- Veri yazma ---
READING_MIN_INTERVAL_S=60
READING_RETENTION_DAYS=90

# --- Bildirim (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Güvenlik ---
DASHBOARD_PASSWORD=
ALLOWED_SOURCE_IP=
AUTH_GRACE_MS=0        # 0 = geçerli cevap gelmese de bağlantıyı koparma (devre dışı)

# --- Depolama (Railway volume) ---
DB_PATH=/data/monitor.db
