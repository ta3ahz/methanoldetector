# --- HTTP / TCP portları ---
# PORT Railway tarafından otomatik atanır; lokal test için ayarlayın.
PORT=3000
PORT_TCP=5020

# --- Modbus ---
MODBUS_SLAVE_ID=1
POLL_INTERVAL_MS=5000
MODBUS_TIMEOUT_MS=2000
COMM_LOSS_THRESHOLD=3

# --- Alarm eşikleri (%LEL) ---
ALARM_LOW_LEL=10
ALARM_HIGH_LEL=20
DATA_STALE_S=60
ALARM_REPEAT_MIN=30

# --- Veri yazma ---
READING_MIN_INTERVAL_S=60
READING_RETENTION_DAYS=90

# --- Bildirim (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Güvenlik ---
DASHBOARD_PASSWORD=
ALLOWED_SOURCE_IP=
AUTH_GRACE_MS=10000

# --- Depolama (Railway volume) ---
DB_PATH=/data/monitor.db
